{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "retrievedAt",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "retrievedAt": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": [
        "sale",
        "rent"
      ],
      "properties": {
        "sale": {
          "type": "object",
          "required": [
            "source",
            "archived",
            "boundaryYear",
            "periods",
            "units",
            "areas"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "archived": {
              "type": "boolean"
            },
            "boundaryYear": {
              "type": "integer"
            },
            "periods": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^\\d{4}Q[1-4]\\*?$"
              }
            },
            "units": {
              "enum": [
                "EUR/m²",
                "EUR/m²/month"
              ]
            },
            "areas": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "postcode",
                  "name",
                  "values",
                  "changePercent",
                  "geometry"
                ],
                "properties": {
                  "postcode": {
                    "type": "string",
                    "pattern": "^\\d{5}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "changePercent": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "geometry": {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "MultiPolygon"
                        ]
                      },
                      "coordinates": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "minItems": 4,
                            "items": {
                              "type": "array",
                              "minItems": 2,
                              "maxItems": 2,
                              "items": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "rent": {
          "type": "object",
          "required": [
            "source",
            "archived",
            "boundaryYear",
            "periods",
            "units",
            "areas"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "archived": {
              "type": "boolean"
            },
            "boundaryYear": {
              "type": "integer"
            },
            "periods": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^\\d{4}Q[1-4]\\*?$"
              }
            },
            "units": {
              "enum": [
                "EUR/m²",
                "EUR/m²/month"
              ]
            },
            "areas": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "postcode",
                  "name",
                  "values",
                  "changePercent",
                  "geometry"
                ],
                "properties": {
                  "postcode": {
                    "type": "string",
                    "pattern": "^\\d{5}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "changePercent": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "geometry": {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "MultiPolygon"
                        ]
                      },
                      "coordinates": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "minItems": 4,
                            "items": {
                              "type": "array",
                              "minItems": 2,
                              "maxItems": 2,
                              "items": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
